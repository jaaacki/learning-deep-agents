{
  "github": {
    "owner": "your-github-username",
    "repo": "your-repo-name",
    "token": "ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",

    "_comment_auth": "Use EITHER token (PAT) above OR the three GitHub App fields below (remove token if using App auth)",
    "appId": null,
    "privateKeyPath": null,
    "installationId": null
  },
  "llm": {
    "provider": "anthropic",
    "apiKey": "sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
    "model": "claude-sonnet-4-20250514",
    "baseUrl": null,

    "_examples": {
      "anthropic":         { "provider": "anthropic",         "apiKey": "sk-ant-xxx", "model": "claude-sonnet-4-20250514", "baseUrl": null },
      "openai":            { "provider": "openai",            "apiKey": "sk-xxx",     "model": "gpt-4",                    "baseUrl": null },
      "ollama":            { "provider": "ollama",            "apiKey": null,          "model": "llama3",                   "baseUrl": null },
      "openai-compatible": { "provider": "openai-compatible", "apiKey": "key-or-null", "model": "my-model",                "baseUrl": "http://localhost:1234/v1" }
    }
  },
  "triageLlm": null,
  "reviewerLlm": null,
  "webhook": {
    "port": 3000,
    "secret": "your-webhook-secret"
  },
  "maxIssuesPerRun": 5,
  "maxToolCallsPerRun": 30
}
